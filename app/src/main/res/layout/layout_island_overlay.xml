<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/islandRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- The Morphing Island Capsule Container -->
    <LinearLayout
        android:id="@+id/islandCapsule"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|top"
        android:background="@drawable/bg_island_capsule"
        android:clipToPadding="false"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- 1. Compact Header Bar (Shown in compact states: Idle / Music / Charging / Notification) -->
        <LinearLayout
            android:id="@+id/compactContainer"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <!-- Compact Left Icon / Album Art -->
            <ImageView
                android:id="@+id/compactLeftIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/bg_nothing_pill"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_music"
                android:visibility="gone" />

            <!-- Compact Left Text (e.g. Charging % or App Name) -->
            <TextView
                android:id="@+id/compactLeftText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:letterSpacing="0.08"
                android:textColor="@color/nothing_white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Center Cutout Spacer (Hugs phone's front camera) -->
            <View
                android:id="@+id/centerCutoutSpacer"
                android:layout_width="28dp"
                android:layout_height="28dp" />

            <!-- Compact Right Text (e.g. Title or Battery) -->
            <TextView
                android:id="@+id/compactRightText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:ellipsize="end"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:textColor="@color/nothing_white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Compact Right Visualizer (Nothing Dot-Matrix Equalizer) -->
            <com.d4rxh.nothingisland.ui.DotMatrixEqualizerView
                android:id="@+id/compactEqualizer"
                android:layout_width="20dp"
                android:layout_height="16dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 2. Expanded Card View (Shown when user taps the Island) -->
        <LinearLayout
            android:id="@+id/expandedContainer"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp"
            android:visibility="gone">

            <!-- Top Row: App Name & Close / Collapse Indicator -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/expandedAppIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_music" />

                <TextView
                    android:id="@+id/expandedSourceAppText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:letterSpacing="0.1"
                    android:text="NOTHING MEDIA"
                    android:textColor="@color/nothing_red"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <!-- Tap to collapse indicator pill -->
                <View
                    android:layout_width="28dp"
                    android:layout_height="3dp"
                    android:background="@drawable/bg_nothing_pill" />
            </LinearLayout>

            <!-- Middle Row: Album Artwork + Title & Artist -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/expandedArtwork"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_nothing_pill"
                    android:scaleType="centerCrop"
                    android:src="@drawable/app_logo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/expandedTitleText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="marquee"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:singleLine="true"
                        android:text="Song Title"
                        android:textColor="@color/nothing_white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/expandedArtistText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Artist Name"
                        android:textColor="@color/nothing_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.d4rxh.nothingisland.ui.DotMatrixEqualizerView
                    android:id="@+id/expandedEqualizer"
                    android:layout_width="26dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- Media Controls Row -->
            <LinearLayout
                android:id="@+id/mediaControlsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnPrev"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?selectableItemBackgroundBorderless"
                    android:contentDescription="Previous"
                    android:padding="8dp"
                    android:src="@drawable/ic_skip_previous" />

                <ImageButton
                    android:id="@+id/btnPlayPause"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"
                    android:background="@drawable/bg_red_pill"
                    android:contentDescription="Play/Pause"
                    android:padding="10dp"
                    android:src="@drawable/ic_pause" />

                <ImageButton
                    android:id="@+id/btnNext"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?selectableItemBackgroundBorderless"
                    android:contentDescription="Next"
                    android:padding="8dp"
                    android:src="@drawable/ic_skip_next" />
            </LinearLayout>

            <!-- Notification Action / Reply Text (if notification state) -->
            <TextView
                android:id="@+id/expandedNotificationBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/nothing_white"
                android:textSize="13sp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
