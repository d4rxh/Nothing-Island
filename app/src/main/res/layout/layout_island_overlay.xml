<?xml version="1.0" encoding="utf-8"?>
<com.d4rxh.nothingisland.ui.IslandRootLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/islandRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/islandContainerRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|top"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- The Morphing Island Capsule Container -->
        <LinearLayout
            android:id="@+id/islandCapsule"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|top"
            android:background="@drawable/bg_island_capsule"
            android:clipChildren="true"
            android:clipToOutline="true"
            android:clipToPadding="false"
            android:elevation="12dp"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <!-- 1. Compact Header Bar (Idle / Music / Charging / Notification / Cricket) -->
            <LinearLayout
                android:id="@+id/compactContainer"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <!-- Compact Left Container for Icon / Album Art (Locked 24x24dp Container) -->
                <FrameLayout
                    android:id="@+id/compactLeftContainer"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center_vertical"
                    android:clipChildren="true"
                    android:clipToOutline="true">

                    <ImageView
                        android:id="@+id/compactLeftIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_dot" />
                </FrameLayout>

                <!-- Compact Left Text (e.g. Charging % or App Name) -->
                <TextView
                    android:id="@+id/compactLeftText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:letterSpacing="0.08"
                    android:textColor="@color/nothing_white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <!-- Center Cutout Spacer (Hugs phone's front camera punch-hole) -->
                <View
                    android:id="@+id/centerCutoutSpacer"
                    android:layout_width="28dp"
                    android:layout_height="28dp" />

                <!-- Compact Right Section (Title / Battery / Cricket Score / Equalizer) -->
                <LinearLayout
                    android:id="@+id/compactRightContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical|end"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/compactRightText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:ellipsize="marquee"
                        android:letterSpacing="0.08"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:maxWidth="80dp"
                        android:singleLine="true"
                        android:textColor="@color/nothing_white"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <!-- Compact Right Visualizer (Nothing Dot-Matrix Equalizer) -->
                    <com.d4rxh.nothingisland.ui.DotMatrixEqualizerView
                        android:id="@+id/compactEqualizer"
                        android:layout_width="20dp"
                        android:layout_height="16dp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- 2. Expanded Card View (Shown when user taps the Island) -->
            <LinearLayout
                android:id="@+id/expandedContainer"
                android:layout_width="290dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp"
                android:visibility="gone">

                <!-- Top Row: App Name & Close / Collapse Indicator -->
                <LinearLayout
                    android:id="@+id/expandedHeaderRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/expandedAppIcon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_music" />

                    <TextView
                        android:id="@+id/expandedSourceAppText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:letterSpacing="0.1"
                        android:text="NOTHING MEDIA"
                        android:textColor="@color/nothing_red"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <!-- Tap to collapse indicator pill -->
                    <View
                        android:id="@+id/expandedCollapsePill"
                        android:layout_width="28dp"
                        android:layout_height="3dp"
                        android:background="@drawable/bg_nothing_pill" />
                </LinearLayout>

                <!-- Middle Row: Album Artwork / Sports Badge + Title & Artist -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Album Artwork / App Icon in Expanded State -->
                    <ImageView
                        android:id="@+id/expandedArtwork"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_nothing_card"
                        android:clipToOutline="true"
                        android:elevation="2dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_music" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/expandedTitleText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="marquee"
                            android:marqueeRepeatLimit="marquee_forever"
                            android:singleLine="true"
                            android:text="TITLE"
                            android:textColor="@color/nothing_white"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/expandedArtistText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="ARTIST"
                            android:textColor="@color/nothing_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Expanded Dot-Matrix Audio Spectrum Visualizer -->
                    <com.d4rxh.nothingisland.ui.DotMatrixEqualizerView
                        android:id="@+id/expandedEqualizer"
                        android:layout_width="24dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <!-- Interactive Media Seekbar Row (dynamicSpot style) -->
                <LinearLayout
                    android:id="@+id/mediaSeekBarRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/textTrackElapsed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00"
                        android:textColor="@color/nothing_text_secondary"
                        android:textSize="10sp" />

                    <SeekBar
                        android:id="@+id/mediaSeekBar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:maxHeight="3dp"
                        android:progressDrawable="@drawable/bg_seekbar_progress"
                        android:thumb="@drawable/bg_seekbar_thumb"
                        android:splitTrack="false" />

                    <TextView
                        android:id="@+id/textTrackDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00"
                        android:textColor="@color/nothing_text_secondary"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Media Playback Control Row -->
                <LinearLayout
                    android:id="@+id/mediaControlsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnPrev"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="?selectableItemBackgroundBorderless"
                        android:contentDescription="Previous"
                        android:padding="10dp"
                        android:src="@drawable/ic_skip_previous" />

                    <ImageButton
                        android:id="@+id/btnPlayPause"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="24dp"
                        android:layout_marginEnd="24dp"
                        android:background="@drawable/bg_red_pill"
                        android:contentDescription="Play/Pause"
                        android:padding="12dp"
                        android:src="@drawable/ic_pause" />

                    <ImageButton
                        android:id="@+id/btnNext"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="?selectableItemBackgroundBorderless"
                        android:contentDescription="Next"
                        android:padding="10dp"
                        android:src="@drawable/ic_skip_next" />
                </LinearLayout>

                <!-- Notification / Cricket Commentary / Body Text -->
                <TextView
                    android:id="@+id/expandedNotificationBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/nothing_white"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <!-- Dynamic Notification Actions (dynamicSpot style - WhatsApp, Telegram, Gmail actions) -->
                <HorizontalScrollView
                    android:id="@+id/notificationActionsScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:overScrollMode="never"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/notificationActionsContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <!-- Call Controls Row (Incoming / Active Call) -->
                <LinearLayout
                    android:id="@+id/callControlsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageButton
                        android:id="@+id/btnDeclineCall"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="32dp"
                        android:background="@drawable/bg_red_pill"
                        android:contentDescription="Decline"
                        android:padding="12dp"
                        android:src="@drawable/ic_call_end" />

                    <ImageButton
                        android:id="@+id/btnAnswerCall"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_green_pill"
                        android:contentDescription="Answer"
                        android:padding="12dp"
                        android:src="@drawable/ic_call" />
                </LinearLayout>

                <!-- Quick Reply Row for Messages (WhatsApp, Telegram, SMS) -->
                <LinearLayout
                    android:id="@+id/quickReplyRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/replyEditText"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_reply_input"
                        android:hint="Type reply..."
                        android:imeOptions="actionSend"
                        android:inputType="textCapSentences"
                        android:maxLines="1"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="@color/nothing_white"
                        android:textColorHint="@color/nothing_text_muted"
                        android:textSize="12sp" />

                    <ImageButton
                        android:id="@+id/btnSendReply"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_red_pill"
                        android:contentDescription="Send"
                        android:padding="9dp"
                        android:src="@drawable/ic_send" />
                </LinearLayout>

                <!-- Timer & Stopwatch Controls Row -->
                <LinearLayout
                    android:id="@+id/timerControlsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/btnTimerReset"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="24dp"
                        android:letterSpacing="0.1"
                        android:padding="8dp"
                        android:text="RESET"
                        android:textColor="@color/nothing_text_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnTimerPlayPause"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_red_pill"
                        android:contentDescription="Timer Toggle"
                        android:padding="12dp"
                        android:src="@drawable/ic_play" />

                    <TextView
                        android:id="@+id/btnTimerLap"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:letterSpacing="0.1"
                        android:padding="8dp"
                        android:text="LAP"
                        android:textColor="@color/nothing_text_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Multi-Event Dot Indicators (Active when 2+ events running) -->
                <LinearLayout
                    android:id="@+id/eventIndicatorDots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <View
                        android:id="@+id/dotEvent1"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/ic_dot" />

                    <View
                        android:id="@+id/dotEvent2"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginStart="6dp"
                        android:alpha="0.3"
                        android:background="@drawable/ic_dot" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Secondary Split Capsule (Apple Dual Island Split Pill for Music + Charging) -->
        <LinearLayout
            android:id="@+id/islandSubCapsule"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_island_capsule"
            android:clipChildren="true"
            android:clipToOutline="true"
            android:elevation="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="10dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/subCapsuleIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_bolt" />

            <TextView
                android:id="@+id/subCapsuleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:letterSpacing="0.08"
                android:textColor="@color/nothing_white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="visible" />
        </LinearLayout>

    </LinearLayout>

</com.d4rxh.nothingisland.ui.IslandRootLayout>